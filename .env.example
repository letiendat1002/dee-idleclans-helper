# Discord
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id

# Database
DATABASE_URL=postgresql://idleclans:idleclans@127.0.0.1:5432/idleclans

# Redis
REDIS_URL=redis://localhost:6379

# Idle Clans API
IDLECLANS_API_BASE=https://query.idleclans.com/api
IDLECLANS_CLIENT_ID=your_developer_client_id_optional

# Discord Guild (for instant slash command registration)
DISCORD_GUILD_ID=your_discord_guild_id

# App
NODE_ENV=development
LOG_LEVEL=info

# Health signal stamped by the poller (default /tmp/dee-heartbeat). The compose
# healthcheck reads that literal path, so change both together.
HEARTBEAT_FILE=/tmp/dee-heartbeat

# Under `docker compose`, docker-compose.yml overrides DATABASE_URL and
# REDIS_URL with the `postgres` / `redis` service names; the values above are
# for running the bot directly on the host.
# Set POSTGRES_PASSWORD to replace the compose default ("idleclans").

# Optional: Postgres pool size (default 10). Raise only with a measured connection need.
PG_POOL_MAX=10
