{
  "name": "dee-idleclans-helper",
  "version": "1.0.0",
  "description": "Dee IdleClans Helper \u2014 Idle Clans market facts for Discord.",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letiendat1002/dee-idleclans-helper.git"
  },
  "keywords": [],
  "author": "Lê Tiến Đạt",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/letiendat1002/dee-idleclans-helper/issues"
  },
  "homepage": "https://github.com/letiendat1002/dee-idleclans-helper#readme",
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
